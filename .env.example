# Copy this to .env.local for local development, and set the same values
# as Environment Variables in your Vercel project for production.
#
# The dashboard itself (countdown, theme, sound alerts) works with NONE of
# these set — they're only needed for push notifications (alerts that reach
# you even when this tab isn't open). See README.md → "Push notifications"
# for full setup steps.

# --- VAPID keys (identify this app to push services) ---
# Generate with: npm run generate-vapid-keys
# The public key is safe to expose to the browser (NEXT_PUBLIC_ prefix is
# required for that); the private key must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL/email push services may use to reach you about your usage.
VAPID_SUBJECT=mailto:you@example.com

# --- Storage for push subscriptions (Upstash Redis) ---
# From the Vercel Marketplace: Storage → Browse → Upstash for Redis → Create.
# Copy the REST URL/token it gives you into these two names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Secret that authorizes calls to /api/push/check ---
# Any long random string. Whatever scheduler you use (Vercel Cron on Pro, or
# a free external scheduler) must send this same value, either as
# `Authorization: Bearer <value>` or `?secret=<value>`.
CRON_SECRET=
